{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zuwer-tech/temperature-anomaly-monitor/docs/schemas/real_data_manifest.schema.json",
  "title": "Temperature anomaly monitor real-data manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "template_only",
    "dataset_id",
    "dataset_version",
    "created_at",
    "description",
    "owner_role",
    "license",
    "publication_permission",
    "split_policy",
    "experiments"
  ],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "template_only": {"type": "boolean"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "description": {"type": "string", "minLength": 1},
    "owner_role": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "publication_permission": {
      "enum": ["public", "internal", "restricted", "no_publication"]
    },
    "split_policy": {"$ref": "#/$defs/split_policy"},
    "experiments": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/experiment"}
    }
  },
  "$defs": {
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "final_test_untouched", "frozen_at", "rationale"],
      "properties": {
        "method": {"const": "by_experiment"},
        "final_test_untouched": {"const": true},
        "frozen_at": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "expected_interval_seconds", "description"],
      "properties": {
        "mode": {"enum": ["regular", "irregular"]},
        "expected_interval_seconds": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "description": {"type": "string", "minLength": 1}
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "expert_labeling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labeler_role", "labeling_date", "review_status", "guidance"],
      "properties": {
        "labeler_role": {"type": "string", "minLength": 1},
        "labeling_date": {"type": "string", "format": "date"},
        "review_status": {
          "enum": ["not_reviewed", "single_expert", "second_expert_consensus"]
        },
        "guidance": {"type": "string", "minLength": 1}
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_data_notes", "maintenance_notes", "regime_change_notes"],
      "properties": {
        "missing_data_notes": {"type": "string"},
        "maintenance_notes": {"type": "string"},
        "regime_change_notes": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "collection_purpose", "source_contact_role"],
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "collection_purpose": {"type": "string", "minLength": 1},
        "source_contact_role": {"type": "string", "minLength": 1}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "split",
        "source_name",
        "installation",
        "equipment_or_process",
        "measurement_file",
        "measurement_sha256",
        "events_file",
        "source_schema",
        "adapter",
        "sensor_ids",
        "source_temperature_unit",
        "canonical_temperature_unit",
        "sampling",
        "time",
        "normal_operation",
        "controlled_event_summary",
        "expert_labeling",
        "data_quality",
        "provenance",
        "access_classification"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "split": {"enum": ["train", "validation", "test"]},
        "source_name": {"type": "string", "minLength": 1},
        "installation": {"type": "string", "minLength": 1},
        "equipment_or_process": {"type": "string", "minLength": 1},
        "measurement_file": {"type": "string", "minLength": 1},
        "measurement_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "events_file": {"type": "string", "minLength": 1},
        "source_schema": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "sensor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_temperature_unit": {"type": "string", "minLength": 1},
        "canonical_temperature_unit": {"const": "°C"},
        "sampling": {"$ref": "#/$defs/sampling"},
        "time": {"$ref": "#/$defs/time"},
        "normal_operation": {"type": "string", "minLength": 1},
        "controlled_event_summary": {"type": "string"},
        "expert_labeling": {"$ref": "#/$defs/expert_labeling"},
        "data_quality": {"$ref": "#/$defs/data_quality"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "access_classification": {
          "enum": ["public", "internal", "restricted"]
        }
      }
    }
  }
}
